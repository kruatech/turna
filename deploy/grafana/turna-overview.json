    {
      "type": "timeseries",
      "title": "Packets relayed",
      "description": "Measured ceiling on a 32-thread Threadripper: 112k pps over loopback, and the failure above it is a cliff not a slope \u2014 7% higher sheds a million frames in two minutes. See docs/capacity/.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "rate(turna_packets_received[5m])",
          "legendFormat": "received",
          "refId": "A"
        },
        {
          "expr": "rate(turna_packets_sent[5m])",
          "legendFormat": "sent",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Bytes relayed",
      "description": null,
      "datasource": {
