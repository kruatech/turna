# syntax=docker/dockerfile:1
#
# Turna admin image: the control-plane admin UI (Vite/React) served by the
# turna-admin HTTP→gRPC bridge. Separate from deploy/Dockerfile (whose
# entrypoint is turna-node) because it ships a different binary + static assets.
#
# Build from repository root:
#   docker build -f deploy/Dockerfile.admin -t turna-admin:local .
#
# Run (the bridge fails closed on a non-loopback listen without a token, so a
# real deployment MUST set both TURNA_ADMIN_LISTEN and TURNA_ADMIN_AUTH_TOKEN):
#   docker run --rm -p 8080:8080 \
#     -e TURNA_ADMIN_LISTEN=0.0.0.0:8080 \
#     -e TURNA_ADMIN_AUTH_TOKEN=<operator-token> \
#     -e TURNA_ADMIN_GRPC_ADDR=<control-plane grpc addr> \
#     turna-admin:local
# =============================================================================
# Stage 1: Frontend (Vite/React) -> static dist/
# =============================================================================
FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS frontend
WORKDIR /fe
# Install against the lockfile first for cache reuse, then build.
COPY services/admin/frontend/package.json services/admin/frontend/package-lock.json ./
RUN npm ci
COPY services/admin/frontend/ ./
# vite.config outDir is '../dist'; relative to WORKDIR /fe that lands in /dist.
RUN npm run build

# =============================================================================
# Stage 2: Rust build (turna-admin)
# =============================================================================
FROM rust:1.95.0-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    cmake \
    libclang-dev \
    pkg-config \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
# Full workspace (source of truth); build only the admin binary.
COPY . .
RUN cargo build --locked --release --bin turna-admin

# =============================================================================
# Stage 3: Runtime
# =============================================================================
FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS runtime

# Same pinned non-root UID/GID convention as deploy/Dockerfile.
ARG TURNA_UID=65532
ARG TURNA_GID=65532

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd -r -g ${TURNA_GID} turna \
    && useradd -r -u ${TURNA_UID} -g turna -d /app -s /usr/sbin/nologin turna

COPY --from=builder  /build/target/release/turna-admin /usr/local/bin/
COPY --from=frontend /dist /app/dist
RUN chown -R turna:turna /app

# OCI metadata. VERSION is passed by the release workflow (--build-arg VERSION);
# the default tracks the current chart/appVersion.
ARG VERSION=0.3.0
LABEL org.opencontainers.image.title="turna-admin" \
      org.opencontainers.image.description="Turna admin UI + control-plane HTTP/gRPC bridge" \
      org.opencontainers.image.source="https://github.com/kruatech/turna" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}"

# Admin HTTP UI/API. Bind is loopback-only by default (secure); override
# TURNA_ADMIN_LISTEN to expose it and set TURNA_ADMIN_AUTH_TOKEN (required for a
# non-loopback bind — the bridge refuses to start otherwise).
EXPOSE 8080/tcp
WORKDIR /app
USER turna
ENV RUST_LOG=info,turna=info
# Serve the built UI from ./dist (matches the --static-dir / TURNA_ADMIN_STATIC_DIR default).
ENV TURNA_ADMIN_STATIC_DIR=/app/dist
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/healthz >/dev/null || exit 1
ENTRYPOINT ["turna-admin"]
