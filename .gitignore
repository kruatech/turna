# Build artifacts
/target/
**/target/
fuzz/target/
fuzz/artifacts/
fuzz/coverage/

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store

# Local logs and bench output
*.log
/tmp/
bench/*.json

# Local environment files — never commit secrets
.env
.env.*
# ...except the tracked template. Its values are test fixtures, published in
# ci.yml's env: block, and without them a fresh clone cannot run cargo test.
!.env.test.example
*.pem
*.key

bench/results/
*.bak

# Python bytecode
__pycache__/
*.pyc

# working artifacts, not part of the project
patches/
node_modules/
air-gap-*/
enterprise-*/
