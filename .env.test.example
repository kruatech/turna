# Test-only environment for `cargo test`. NOT secrets.
#
# The auth and processor suites read their fixtures from the environment rather
# than holding literals in source. Without these set, five tests in turna-relay
# and several in turna-auth panic with "... is not set — source .env.test", which
# is what a fresh clone hits on `cargo test --workspace`.
#
# The canonical copy lives in the `env:` block of .github/workflows/ci.yml, which
# is why CI is green while a clean checkout is not. `scripts/check-doc-claims.sh`
# fails if the two drift apart.
#
# Usage:
#
#   cp .env.test.example .env.test
#   set -a && source .env.test && set +a
#   cargo test --workspace --all-features
#
# `.env.test` itself stays gitignored so a real secret pasted in by mistake is
# never committed. Only this example is tracked.
#
# Some values are deliberately invalid — the tests assert they are REJECTED.
# TURNA_TEST_PW_TOOSHORT is below the length minimum; the BAD_NONCE_* trio are
# malformed nonces; TURNA_TEST_PW_T4 and WRONG_PW are wrong on purpose. Do not
# "fix" them.

TURNA_TEST_PW_V1="password123"
TURNA_TEST_PW_V2="pass12345"
TURNA_TEST_PW_T1="hunter2"
TURNA_TEST_PW_T2="pw"
TURNA_TEST_PW_TOOSHORT="abc"
TURNA_TEST_BAD_NONCE_GARBLED="not-a-nonce"
TURNA_TEST_BAD_NONCE_NOTHEX="zz:zz"
TURNA_TEST_BAD_NONCE_EMPTY=""
TURNA_TEST_CLIENT_ID="c"
TURNA_TEST_PEER_ADDR="203.0.113.7:51000"
TURNA_TEST_NONCE_TS="1234"
TURNA_TEST_KEY_K1="17"
TURNA_TEST_KEY_K2="66"
TURNA_TEST_KEY_K3="55"
TURNA_TEST_KEY_K4="0"
TURNA_TEST_PW_T3="correct-pass"
TURNA_TEST_PW_T4="wrong-pass"
TURNA_TEST_NONCE_SECRET="test-secret"
TURNA_TEST_PASS="testpass"
TURNA_TEST_WRONG_PW="definitely-wrong-password"
TURNA_TEST_TURN_SECRET="turna-secret"
